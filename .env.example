# Environment
NODE_ENV=development
PORT=3000

# PostgreSQL
POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleet
POSTGRES_DB=fleetexpense
DATABASE_URL=postgresql://fleet:fleet@localhost:5433/fleetexpense

# JWT
JWT_SECRET=dev-jwt-secret-change-me-in-production
JWT_EXPIRES_IN=8h

# CORS
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# n8n / servicio de integración
SERVICE_API_KEY=dev-service-api-key-change-me

# Seed admin
ADMIN_EMAIL=admin@fleetexpense.local
ADMIN_PASSWORD=Admin123!
